# Logging
LOG_LEVEL=INFO

# Tavily (web search)
TAVILY_API_KEY=

# YouTube (optional; without it: RSS fallback, no transcripts)
YOUTUBE_API_KEY=

# OpenAI (optional; enables the daily visual's gpt-image render)
OPENAI_API_KEY=

# Threads delivery (optional; 60-day token auto-refreshed to SSM in AWS)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=


# Alerting (required for deploy: scripts/deploy.py refuses to run without it, since a deploy
# without the address removes the alert email subscription)
ALERT_EMAIL=

# Local -> S3 sync (scripts/sync_to_s3.py); optional, falls back to AWS_PROFILE
S3_SYNC_ACCESS_KEY_ID=
S3_SYNC_SECRET_ACCESS_KEY=
